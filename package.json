{
  "name": "ping-backend-functions",
  "description": "PING 결제 승인 백엔드 - Firebase Cloud Functions",
  "version": "1.0.0",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "postinstall": "prisma generate && node scripts/ensure-next-public-static.mjs",
    "deploy:prep": "npm run sync:static-for-next && npm run check",
    "check": "node scripts/run-check.mjs",
    "check:vercel-env": "node scripts/check-vercel-production-env.cjs",
    "check:vercel-env:strict": "node scripts/check-vercel-production-env.cjs --strict",
    "github:repo-description": "node scripts/set-github-repo-description.mjs",
    "wiki:push": "node scripts/push-github-wiki.mjs",
  "sync:vercel-env": "node scripts/sync-vercel-production-env.mjs",
    "push:vercel-member-auth-env": "node scripts/push-vercel-member-auth-env.mjs",
  "deploy:express": "node scripts/deploy-express-cloud-run.mjs",
  "verify:production": "node scripts/verify-production-handoff.mjs",
    "test:solapi": "node scripts/test-solapi-send.js",
    "test:naver-addrbook": "node scripts/test-naver-addressbook-parse.mjs",
    "build:bugo-parse": "node scripts/build-bugo-funeral-parse.mjs",
    "gen:bugo-parse-ts": "node scripts/gen-bugo-funeral-parse-ts.mjs",
    "smoke": "npm run next:build && node scripts/smoke-test.js",
    "materialize:legacy-html": "node scripts/materialize-legacy-html.mjs",
    "prune:legacy-html-copies": "node scripts/prune-legacy-html-copies.mjs",
    "sync:static-for-next": "node scripts/prune-legacy-html-copies.mjs && node scripts/materialize-legacy-html.mjs && node scripts/ensure-next-public-static.mjs",
    "archive:legacy-html": "node scripts/export-legacy-html-snapshot.mjs",
    "fix:next-app-dir": "node scripts/rename-root-app-for-next.js",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:hosting": "firebase deploy --only hosting",
    "deploy": "firebase deploy --only functions,hosting",
    "logs": "firebase functions:log",
    "dev": "concurrently -n express,next -c blue,magenta \"node scripts/run-express-dev.mjs\" \"npm run next:dev\"",
    "dev:clean": "node scripts/kill-dev-ports.mjs && npm run dev",
    "dev:docker": "docker compose up --build",
    "dev:express": "node scripts/run-express-dev.mjs",
    "dev:stack": "npm run dev",
    "dev:ui": "node scripts/run-next-dev.mjs",
    "next:dev": "node scripts/run-next-dev.mjs",
    "next:dev:clean": "npm run clean:next && npm run next:dev",
    "build": "next build",
    "next:build": "next build",
    "clean:next": "node scripts/clean-next.mjs",
    "next:rebuild": "npm run clean:next && npm run next:build",
    "server": "node server.js",
    "pack:dispatch": "npm pack ./ping-dispatch"
  },
  "engines": {
    "node": "20"
  },
  "main": "index.js",
  "dependencies": {
    "@portone/browser-sdk": "^0.1.1",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.10.0",
    "cheerio": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase": "^10.14.1",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^4.9.0",
    "jose": "^4.15.9",
    "lucide-react": "^1.16.0",
    "next": "^15.5.18",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "solapi": "^5.5.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^6.0.3",
    "xlsx": "^0.18.5",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "firebase-functions-test": "^3.1.0",
    "iconv-lite": "^0.7.2",
    "postcss": "^8.4.49",
    "prisma": "^7.8.0",
    "tailwindcss": "^3.4.17"
  },
  "private": true
}
