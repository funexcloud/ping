# 운영 호스트 예: https://ping.funexcloud.com
# PG(결제대행)·OAuth 콘솔에 동일 원본(URL)·리디렉션 URI 등록.

# --- 안심 부고 링크(opaque token) — /s/{token} 서버 저장·발인 만료 ---
# 신규 링크에는 URL·고인명·주문번호를 넣지 않고 Redis에 목적지와 만료 시각만 저장합니다.
# Redis 연결은 아래 UPSTASH_REDIS_REST_* 또는 KV_REST_API_* 설정을 함께 사용합니다.
# 기존 JWT 링크의 검증만 유지할 때 사용하며, 신규 링크 발급에는 사용하지 않습니다.
# PING_SAFE_LINK_SECRET=
# 마이그레이션 종료 후 0으로 설정하면 기존 JWT 링크 검증도 중단합니다.
# PING_SAFE_LINK_ALLOW_LEGACY_JWT=1
# (선택) 문자에 들어갈 절대 URL 의 캐논 도메인. 미설정 시 요청 호스트 → NEXT_PUBLIC_SITE_URL 순.
# PING_SAFE_LINK_ORIGIN=https://ping.funexcloud.com
# Safe Link는 승인된 부고 서비스, 지도, 공공기관, PING 내부 링크만 기본 허용합니다.
# 추가 부고 서비스 도메인(쉼표 구분, 서브도메인 포함 허용):
# PING_SAFE_LINK_OBITUARY_HOSTS=
# 승인된 장례식장 공식 도메인:
# PING_SAFE_LINK_FUNERAL_HALL_HOSTS=
# 추가 공공기관 공식 도메인:
# PING_SAFE_LINK_PUBLIC_HOSTS=
# 화이트라벨 등 PING 내부 부고장 도메인:
# PING_SAFE_LINK_INTERNAL_HOSTS=
# 공개 URL 파싱에서 추가 차단할 단축 URL 도메인:
# PING_BLOCKED_SHORT_URL_HOSTS=

# --- 주문 API 단기 capability token ---
# 결제 확인 후 조회·환불·재발송·현금영수증 API에 사용할 서명 키입니다.
# 운영에서는 다른 서명 키와 분리한 32바이트 이상의 임의 값을 사용하세요.
# PING_ORDER_CAPABILITY_SECRET=
# 기본 2시간, 최소 5분·최대 24시간
# PING_ORDER_CAPABILITY_TTL_SECONDS=7200
# 무통장 입금은 입금 확인 대기 시간을 고려해 기본 24시간
# PING_BANK_TRANSFER_CAPABILITY_TTL_SECONDS=86400

# --- 상주 계좌 직접 등록 링크 ---
# 문자로 보내는 상주별 계좌 입력 링크 서명 키입니다. 운영에서는 다른 서명 키와 분리하세요.
# PING_MOURNER_ACCOUNT_SECRET=
# 기본 7일, 최소 1시간·최대 14일
# PING_MOURNER_ACCOUNT_TTL_SECONDS=604800

# --- 분산 Rate Limit (Upstash Redis REST / Vercel KV 호환) ---
# OTP, 관리자 로그인, 주문 조회·환불·재발송·현금영수증 제한을 모든 서버 인스턴스가 공유합니다.
# 운영에서 미설정 또는 Redis 장애 시 민감 API는 503으로 fail-closed 됩니다.
# UPSTASH_REDIS_REST_URL=https://...
# UPSTASH_REDIS_REST_TOKEN=
# Vercel KV를 사용하는 경우 위 변수 대신 아래 이름도 인식합니다.
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=
# Redis 키에 전화번호·이메일·주문번호 원문을 남기지 않는 HMAC 키(32바이트 이상):
# PING_RATE_LIMIT_KEY_SECRET=
# 감사로그 원문 식별자 비식별화 및 해시 체인 HMAC 키(별도 32바이트 이상):
# PING_AUDIT_LOG_HMAC_SECRET=
# 회원·세션·OTP를 Redis에 저장할 때 사용하는 AES-256-GCM 키
# 미설정 시 PING_SAFE_LINK_SECRET에서 용도 분리 키를 파생합니다.
# PING_MEMBER_STORE_ENCRYPTION_KEY=
# 로컬(NODE_ENV≠production)은 members.local.json을 씁니다. 운영 Redis를 로컬에서 쓰려면:
# PING_MEMBER_STORE_REDIS=1
# 강제로 로컬 파일만 쓰려면:
# PING_MEMBER_STORE_LOCAL=1
# 디지털 방명록: 로컬(next dev)은 기본 condolence-book.local.json.
# 로컬에서 Upstash를 쓰려면 PING_CONDOLENCE_STORE_REDIS=1
# 로컬 파일만 강제하려면 PING_CONDOLENCE_STORE_LOCAL=1

# --- Firebase App Check + 이상행위 탐지 ---
# Firebase Console에서 Web App에 reCAPTCHA Enterprise를 등록한 뒤 사이트 키를 설정합니다.
# NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=
# 기본 provider는 recaptcha-enterprise. v3 사용 시 recaptcha-v3:
# NEXT_PUBLIC_FIREBASE_APP_CHECK_PROVIDER=recaptcha-enterprise
# monitor: 위험 신호 감사로그만 기록, enforce: App Check 미검증 요청 차단
# PING_APP_CHECK_ENFORCEMENT=monitor
# 위험 점수가 이 값 이상이면 App Check 모드와 무관하게 차단 (기본 80)
# PING_ANOMALY_BLOCK_SCORE=80
# 로컬(NODE_ENV≠production)은 localhost와 이 PC LAN IP를 자동 허용합니다.
# 자동 감지에 없는 주소만 추가로:
# PING_DEV_ORIGINS=http://192.168.0.10:3002
# 애플리케이션 WAF: monitor 또는 enforce (기본 enforce)
# PING_WAF_ENFORCEMENT=enforce
# 추모관(/memorial/*) — production 기본 비노출. 켜려면 PING_MEMORIAL_ENABLED=1
# PING_MEMORIAL_ENABLED=0
# WAF 차단 점수 (기본 80)
# PING_WAF_BLOCK_SCORE=80

# --- Google Cloud KMS envelope encryption ---
# projects/{project}/locations/{location}/keyRings/{ring}/cryptoKeys/{key}
# PING_KMS_KEY_NAME=
# enforce 시 운영에서 KMS 키가 없거나 호출 실패하면 민감 저장을 중단합니다.
# PING_KMS_ENFORCEMENT=enforce

# --- 개인정보 파기 연계 백업·복구 ---
# 백업은 KMS 암호화하며 버킷 lifecycle로 자동 삭제합니다. 최대 30일, 기본 1일.
# PING_BACKUP_BUCKET=ping-3a510-retention-backups
# PING_BACKUP_REGION=asia-northeast3
# PING_BACKUP_RETENTION_DAYS=1
# 설정: npm run setup:backup-bucket
# 회원 저장소: npm run backup:member-store
# Firestore: npm run backup:firestore (백업 직전 파기 Cron 필수)
# 복구는 격리 프로젝트에서만 허용하며 복구 직후 파기 Cron을 강제합니다.

# 마케팅 「도입하기」 CTA — 통합 콘솔 PING (기본 https://console.funexcloud.com/ping)
# NEXT_PUBLIC_PING_CONSOLE_URL=https://console.funexcloud.com/login?next=/dashboard/ping

# 기술블로그 — Vlen CMS (ping `/tech-blog` 허브 → 글 본문 canonical)
# NEXT_PUBLIC_VLEN_BLOG_ORIGIN=https://vlen.funexcloud.com

# (선택) 토스 승인·checkout 세션·포인트 결제 API만 별도 Express 호스트에 둘 때 — 끝 슬래시 없이.
# 정적 Firebase Hosting만 두면 이 경로들은 firebase.json 리라이트에 없음 → 비우면 클라이언트는 동일 출처 /api 로 요청.
# PING_BACKEND_API_ORIGIN=https://ping-3a510.web.app
# PING_EXPRESS_ORIGIN=https://ping-express-api-xxxxx-an.a.run.app  (npm run deploy:express 후 .ping-express-origin)
# NEXT_PUBLIC_SITE_URL=https://ping.funexcloud.com
# PING_PUBLIC_ORIGIN=https://ping.funexcloud.com

# 로컬에서 `npm run dev` 로 server.js 를 띄울 때만 적용됩니다.
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (`.env` 는 git 에 올리지 마세요.)
# 프로덕션 UI: Vercel(Next) · API: PING_BACKEND_API_ORIGIN 또는 Firebase Functions — docs/deployment-axis-decision.md

# 포트 충돌 시: npm run dev:clean  ·  Docker: npm run dev:docker

# --- 공공데이터포털 장례 행정 ODMS (장례식장·화장시설 조회) ---
# 미설정 시 funeral-odms-config.js 레거시 폴백(개발용). 운영·Firebase Functions는 반드시 설정.
# 화장시설(ODMS_DATA_05_1)은 별도 활용신청이 필요할 수 있습니다. 미신청 시 내장 전국 화장장 목록을 씁니다.
# @see https://www.data.go.kr/
DATA_GO_KR_SERVICE_KEY=
FUNERAL_API_KEY=

# --- Google 연락처 (People API + OAuth) — `/start` Google 연락처 가져오기 ---
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
#
# 1) OAuth 클라이언트 ID
#    - 유형: 웹 애플리케이션
#    - 승인된 JavaScript 원본: http://localhost:3000 , https://ping.funexcloud.com (운영)
#
# 2) API 키 (브라우저용)
#    - API 제한: Google People API
#    - 애플리케이션 제한: HTTP 리퍼러 → http://localhost:3000/* , https://ping.funexcloud.com/*
#
# 3) API 라이브러리에서 "People API" 사용 설정
#
# 4) OAuth 동의 화면: 범위 https://www.googleapis.com/auth/contacts.readonly
#    검증 전에는 "테스트 사용자"에 본인 Gmail 추가 필요.
#    상세: GOOGLE_CONTACTS_VERIFICATION_GUIDE.md
#
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_API_KEY=

# (선택) 호환 별칭
# GOOGLE_CLIENT_ID=

# --- 토스페이먼츠 단일 연동 (포트원 브라우저 SDK) ---
# 포트원 콘솔에서 결제대행사「토스페이먼츠」채널만 생성·연결한 뒤 아래에 맞게 입력합니다.
# 브라우저에는 storeId·channelKey만 노출됩니다. 시크릿 키는 서버 검증용으로만 .env에 두세요.
#
# PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_SECRET_KEY=test_sk_...   # 서버에서 결제 검증 API 연동 시 (현재 approvePayment는 로컬 목업)
# PORTONE_CLIENT_KEY=test_ck_...   # API·결제창용. 결제위젯 v2(TossPayments.widgets)에는 보통 맞지 않음.
#
# 결제위젯 v2 — 연동 가이드: https://docs.tosspayments.com/guides/v2/payment-widget/integration
# 가이드에 나온 공개 샌드박스 키만 쓰려면(신청 전 연습):
# PING_USE_TOSS_DOCS_TEST_KEYS=1
#
# 전자결제 신청 후 개발자센터 키 (부고 대량발송·답례문자·방명록 영구 이용권 공통):
# TOSS_PAYMENTS_WIDGET_CLIENT_KEY=test_gck_...
# TOSS_PAYMENTS_SECRET_KEY=test_gsk_...
# (호환) TOSS_PAYMENTS_WIDGET_SECRET_KEY=…  — 위와 동일 시크릿을 다른 이름으로 둘 때
# (호환) TOSS_WIDGET_CLIENT_KEY=…  — 위젯 클라이언트 키 별칭
#
# --- 로컬·UI 테스트용 (실제 토스 승인 API를 호출하지 않음. 운영에서는 제거) ---
# PING_TOSS_CONFIRM_MOCK=1
#
# --- test_ck_로 위젯 초기화를 강제 시도(토스 정책상 실패할 수 있음) ---
# PING_ALLOW_CK_WIDGET_TRY=1
#
# --- Firebase Storage (localhost에서 CORS 에러 날 때) ---
# 주소록 CSV/파일 업로드만 건너뛰고 Firestore 주문·결제는 진행:
# PING_SKIP_FIREBASE_STORAGE_UPLOAD=1
# 버킷 CORS 설정(프로젝트 루트 firebase-storage-cors.json):
#   gsutil cors set firebase-storage-cors.json gs://<버킷명>
#   예: gs://ping-3a510.firebasestorage.app  (Firebase 콘솔 · Storage에 표시된 버킷)

# --- Server-side canonical order (기본 OFF, staging parity 후 ON) ---
# PING_SERVER_ORDER_CREATE=1
# PING_CHECKOUT_CAPABILITY_SECRET=  # production 필수, secret manager 사용
# PING_CHECKOUT_SESSION_TTL_SECONDS=172800
# PING_CHECKOUT_RESERVATION_TTL_SECONDS=600
# PING_CHECKOUT_REGISTRY_BACKEND=firestore
# local JSON fallback은 비운영 개발에서만 명시적으로 허용:
# PING_CHECKOUT_REGISTRY_BACKEND=local

# --- 민감 데이터 자동 파기 (G) — Vercel Cron /api/cron/purge-sensitive-data ---
# CRON_SECRET=   # Vercel Cron Authorization Bearer (Production 필수 — 없으면 Cron 401)
# PING_RECIPIENT_PURGE_HOURS=24
# PING_FAILED_DETAIL_RETENTION_HOURS=24
# PING_PURGE_DAYS_AFTER_DEPARTURE=30
# Firestore 단일 필드 인덱스: ping_orders — recipientPurgeAfter, failedDetailPurgeAfter, purgeAfter

# --- 관리자 (/admin) — PinGate UI 로그인 (운영 env 필수) ---
# UI 로그인: /admin/auth (rotate 후 새 값만 사용)
# PING_ADMIN_UI_PASSWORD=26061499
# 입금확인·발송 트리거 API (curl/자동화) — UI PIN 과 다른 값
# PING_ADMIN_API_KEY=
# (선택) 세션 쿠키 서명 — 미설정 시 PING_ADMIN_API_KEY 사용
# PING_ADMIN_SESSION_SECRET=
# (호환) 예전 단일 비밀번호 — UI 로그인에만 폴백, API 키로는 쓰이지 않음
# PING_ADMIN_PASSWORD=
# 메시지 원가표 2차 암호 (/admin/cost-pricing) — 관리자 PIN과 별도
# PING_ADMIN_COST_PASSWORD=
# 무통장 입금 요청 시 관리자 문자 알림 (Solapi LMS — SOLAPI_* 필요)
# PING_ADMIN_NOTIFY_PHONE=01031030282
# PING_BANK_TRANSFER_ADMIN_NOTIFY=1
# PING_BANK_TRANSFER_ADMIN_SMS_TEMPLATE=[PING 관리자 알림]\n무통장 입금이 요청되었습니다.\n\n주문번호: {{orderId}}\n신청인: {{customerName}} ({{customerPhone}})\n입금요청액: {{bankTransferAmount}}원\n주문합계: {{orderTotal}}원\n관리자 확인: {{adminUrl}}
# (선택) 알림톡 — PING_BANK_TRANSFER_ADMIN_NOTIFY_CHANNEL=kakao_alimtalk
# PING_BANK_TRANSFER_ADMIN_ALIMTALK_TEMPLATE_ID=
# 신규 파트너·가입신청·제휴문의 시 관리자 문자 (기본 01031030282, SOLAPI_* 필요)
# PING_PARTNER_ADMIN_NOTIFY=1
# PING_PARTNER_ADMIN_SMS_TEMPLATE=… {{partnerName}} {{partnerCode}} {{contactName}} {{contactPhone}} {{email}} {{partnerLink}} {{adminUrl}}
# PING_PARTNER_SIGNUP_ADMIN_SMS_TEMPLATE=… {{joinTypeLabel}} {{displayName}} {{phone}} {{email}} {{adminUrl}}
# PING_PARTNERSHIP_LEAD_ADMIN_SMS_TEMPLATE=… {{companyName}} {{contactName}} {{phone}} {{email}} {{partnershipType}} {{adminUrl}}
# PING_PARTNER_ADMIN_NOTIFY_CHANNEL=sms
# PING_PARTNER_ADMIN_ALIMTALK_TEMPLATE_ID=

# --- Solapi 대량발송 (알림톡 우선, LMS 폴백) — ping-dispatch 모듈 ---
# 콘솔: https://solapi.com  · 카카오 채널·알림톡 템플릿 사전 등록 필요.
# 백업: 프로젝트 루트에서 `npm run pack:dispatch` → ping-dispatch-1.0.0.tgz
#
# PING_DISPATCH_USE_SOLAPI=1
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_FROM=          # 비우면 `npm run test:solapi` 가 계정 ACTIVE 발신번호를 API로 조회
# PING_SEND_FROM_LABEL= # (선택) 플로우·결제완료 화면 발신번호 표시 — 미설정 시 SOLAPI_FROM 포맷
# SOLAPI_TEST_TO=       # 수신 테스트 번호(미지정 시 발신번호로 자가 LMS 테스트)
# PING_DISPATCH_PRIMARY_CHANNEL=kakao_alimtalk   # 또는 sms
# SOLAPI_KAKAO_PF_ID=          # 카카오 채널 ID (구 pfId)
# SOLAPI_KAKAO_TEMPLATE_ID=  # 승인된 알림톡 템플릿 ID
# PING_DISPATCH_BATCH_SIZE=1000
# PING_DISPATCH_FALLBACK_SMS=1
#
# --- 회원 이메일 인증 (Resend) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# PING_PUBLIC_ORIGIN=
# PING_SKIP_EMAIL_VERIFICATION=

# --- 카카오 로그인 · 카카오싱크 (developers.kakao.com) ---
# 앱 → 플랫폼 → Web 사이트 도메인: http://localhost:3002 , https://ping.funexcloud.com
# 앱 → 카카오 로그인 → 활성화 ON · 카카오싱크(동의항목) 설정
#
# [호출 허용 IP] 앱 → 앱 설정 → 보안 → 호출 허용 IP
#   REST API 키로 서버에서 토큰 교환 시, 등록된 IP 외에서는 API 호출 불가.
#   등록 형식: IPv4(203.0.113.10), CIDR(203.0.113.0/24), Subnet Mask(203.0.113.0/255.255.255.0)
#   로컬 개발: 공인 IP 또는 VPN/터널 egress IP를 콘솔에 등록. (아래 env는 운영 메모용)
# KAKAO_SERVER_EGRESS_IP=203.0.113.10
# KAKAO_SERVER_EGRESS_CIDR=203.0.113.0/24
#
# [카카오 로그인 Redirect URI] 카카오 로그인 → Redirect URI — 아래 3개 등록
#   http://localhost:3002/api/auth/kakao/callback
#   http://localhost:3000/api/auth/kakao/callback
#   https://ping.funexcloud.com/api/auth/kakao/callback
#
# [비즈니스 인증 Redirect URI] 비즈니스 인증 → Redirect URI — 아래 3개 등록
#   http://localhost:3002/api/auth/kakao/business/callback
#   http://localhost:3000/api/auth/kakao/business/callback
#   https://ping.funexcloud.com/api/auth/kakao/business/callback
#
# REST API 키 (필수). Client Secret 사용 시 콘솔에서 활성화 후 아래에 입력.
KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
#
# 로컬 npm run dev — OAuth 콜백은 Express(:3000) 기준. (Next :3002 프록시도 동일 Express로 연결)
# ⚠️ 포트 3000에 다른 dev 서버(Vite 등)가 떠 있으면 Express가 안 뜨고 카카오 로그인이 깨집니다.
#   netstat -ano | findstr :3000  로 확인 후 종료하거나 PING_EXPRESS_PORT=3001 로 변경하세요.
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
KAKAO_BUSINESS_REDIRECT_URI=http://localhost:3000/api/auth/kakao/business/callback
#
# (선택) JS SDK 사용 시
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
# Kakao Maps Web SDK also uses the JavaScript key, not the REST API key.
# Register these Web site domains in Kakao Developers > App > Platform:
# http://localhost:3000, http://localhost:3002, https://ping.funexcloud.com
#
# OAuth 콜백 후 회원 로그인 페이지로 돌아갈 공개 origin (미설정 시 PING_PUBLIC_ORIGIN)
# KAKAO_LOGIN_RETURN_ORIGIN=http://localhost:3002
#
# 카카오싱크 약관 태그 — 비즈니스 콘솔 «동의 항목 › 약관»에 등록한 고유 코드.
# 이용약관은 ping_service_terms 로 식별(여러 개는 콤마 구분). 미설정 시 코드 기본값 사용.
# KAKAO_SERVICE_TERMS_TAGS=ping_service_terms

# --- Vercel Production: Express 없이 회원·게스트 인증 (Next /api/auth) ---
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 비공개 키 JSON (한 줄로 Vercel에 등록)
# Production에서는 서비스 계정 JSON을 환경변수로 저장하지 않는다.
# Cloud Run은 연결된 런타임 서비스 계정(ADC)을 사용한다.
# 로컬 개발에서만 PING_FIREBASE_SERVICE_ACCOUNT_PATH를 사용할 수 있다.
# PING_FIREBASE_SERVICE_ACCOUNT_PATH=path/to/firebase-adminsdk.json
# Vercel Production OIDC -> GCP Workload Identity Federation (비밀값 아님)
# GCP_PROJECT_ID=ping-3a510
# GCP_PROJECT_NUMBER=
# GCP_SERVICE_ACCOUNT_EMAIL=ping-vercel-runtime@ping-3a510.iam.gserviceaccount.com
# GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
# GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# PING_MEMBER_GCS_BUCKET=ping-3a510-member-auth
# PING_OAUTH_STATE_SECRET=   # openssl rand -hex 32 (미설정 시 스크립트가 생성)
# FUNEX Central Auth (Google-first SSO). Do not put secrets in git.
# FUNEX_AUTH_BASE_URL=https://auth.funexcloud.com
# FUNEX_PING_CLIENT_SECRET=
# --- 순간 트래픽 집중 제어 (10초 고정 창) ---
# PING_SPIKE_PAYMENT_GLOBAL_10S=30
# PING_SPIKE_PAYMENT_IP_10S=5
# PING_SPIKE_EXPENSIVE_GLOBAL_10S=50
# PING_SPIKE_EXPENSIVE_IP_10S=8
# PING_SPIKE_MUTATION_GLOBAL_10S=120
# PING_SPIKE_MUTATION_IP_10S=20
# PING_SPIKE_READ_GLOBAL_10S=500
# PING_SPIKE_READ_IP_10S=60
# PING_CLOUD_RUN_CONCURRENCY=20
# PING_CLOUD_RUN_MIN_INSTANCES=1
# PING_CLOUD_RUN_MAX_INSTANCES=5
