# 운영 호스트 예: https://ping.funexcloud.com
# PG(결제대행)·OAuth 콘솔에 동일 원본(URL)·리디렉션 URI 등록.

# --- 안심 부고 링크(동적 토큰) — /s/{token} 서명·발인 만료 ---
# 외부 부고 URL 을 PING 서명 토큰으로 감싸 위·변조를 차단합니다(JWT/HS256).
# 운영에서는 반드시 길고 랜덤한 값으로 설정하세요(미설정 시 운영에서 발급/검증 실패).
#   예: openssl rand -base64 48
# PING_SAFE_LINK_SECRET=
# (선택) 문자에 들어갈 절대 URL 의 캐논 도메인. 미설정 시 요청 호스트 → NEXT_PUBLIC_SITE_URL 순.
# PING_SAFE_LINK_ORIGIN=https://ping.funexcloud.com

# 마케팅 「도입하기」 CTA — 통합 콘솔 PING (기본 https://console.funexcloud.com/ping)
# NEXT_PUBLIC_PING_CONSOLE_URL=https://console.funexcloud.com/login?next=/dashboard/ping

# (선택) 토스 승인·checkout 세션·포인트 결제 API만 별도 Express 호스트에 둘 때 — 끝 슬래시 없이.
# 정적 Firebase Hosting만 두면 이 경로들은 firebase.json 리라이트에 없음 → 비우면 클라이언트는 동일 출처 /api 로 요청.
# PING_BACKEND_API_ORIGIN=https://ping-3a510.web.app
# PING_EXPRESS_ORIGIN=https://ping-express-api-xxxxx-an.a.run.app  (npm run deploy:express 후 .ping-express-origin)
# NEXT_PUBLIC_SITE_URL=https://ping.funexcloud.com
# PING_PUBLIC_ORIGIN=https://ping.funexcloud.com

# 로컬에서 `npm run dev` 로 server.js 를 띄울 때만 적용됩니다.
# 이 파일을 복사해 `.env` 로 저장한 뒤 값을 채우세요. (`.env` 는 git 에 올리지 마세요.)
# 프로덕션 UI: Vercel(Next) · API: PING_BACKEND_API_ORIGIN 또는 Firebase Functions — docs/deployment-axis-decision.md

# 포트 충돌 시: npm run dev:clean  ·  Docker: npm run dev:docker

# --- 공공데이터포털 장례 행정 ODMS (장례식장 조회 API) ---
# 미설정 시 funeral-odms-config.js 레거시 폴백(개발용). 운영·Firebase Functions는 반드시 설정.
# @see https://www.data.go.kr/
# DATA_GO_KR_SERVICE_KEY=
# (호환) FUNERAL_API_KEY=

# --- Google 연락처 (People API + OAuth) — `/start` Google 연락처 가져오기 ---
# Google Cloud Console → API 및 서비스 → 사용자 인증 정보
#
# 1) OAuth 클라이언트 ID
#    - 유형: 웹 애플리케이션
#    - 승인된 JavaScript 원본: http://localhost:3000 , https://ping.funexcloud.com (운영)
#
# 2) API 키 (브라우저용)
#    - API 제한: Google People API
#    - 애플리케이션 제한: HTTP 리퍼러 → http://localhost:3000/* , https://ping.funexcloud.com/*
#
# 3) API 라이브러리에서 "People API" 사용 설정
#
# 4) OAuth 동의 화면: 범위 https://www.googleapis.com/auth/contacts.readonly
#    검증 전에는 "테스트 사용자"에 본인 Gmail 추가 필요.
#    상세: GOOGLE_CONTACTS_VERIFICATION_GUIDE.md
#
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_API_KEY=

# (선택) 호환 별칭
# GOOGLE_CLIENT_ID=

# --- 토스페이먼츠 단일 연동 (포트원 브라우저 SDK) ---
# 포트원 콘솔에서 결제대행사「토스페이먼츠」채널만 생성·연결한 뒤 아래에 맞게 입력합니다.
# 브라우저에는 storeId·channelKey만 노출됩니다. 시크릿 키는 서버 검증용으로만 .env에 두세요.
#
# PORTONE_STORE_ID=store-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_CHANNEL_KEY=channel-key-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# PORTONE_SECRET_KEY=test_sk_...   # 서버에서 결제 검증 API 연동 시 (현재 approvePayment는 로컬 목업)
# PORTONE_CLIENT_KEY=test_ck_...   # API·결제창용. 결제위젯 v2(TossPayments.widgets)에는 보통 맞지 않음.
#
# 결제위젯 v2 — 연동 가이드: https://docs.tosspayments.com/guides/v2/payment-widget/integration
# 가이드에 나온 공개 샌드박스 키만 쓰려면(신청 전 연습):
# PING_USE_TOSS_DOCS_TEST_KEYS=1
#
# 전자결제 신청 후 개발자센터 키:
# TOSS_PAYMENTS_WIDGET_CLIENT_KEY=test_gck_...
# TOSS_PAYMENTS_SECRET_KEY=test_gsk_...
# (호환) TOSS_PAYMENTS_WIDGET_SECRET_KEY=…  — 위와 동일 시크릿을 다른 이름으로 둘 때
# (호환) TOSS_WIDGET_CLIENT_KEY=…  — 위젯 클라이언트 키 별칭
#
# --- 로컬·UI 테스트용 (실제 토스 승인 API를 호출하지 않음. 운영에서는 제거) ---
# PING_TOSS_CONFIRM_MOCK=1
#
# --- test_ck_로 위젯 초기화를 강제 시도(토스 정책상 실패할 수 있음) ---
# PING_ALLOW_CK_WIDGET_TRY=1
#
# --- Firebase Storage (localhost에서 CORS 에러 날 때) ---
# 주소록 CSV/파일 업로드만 건너뛰고 Firestore 주문·결제는 진행:
# PING_SKIP_FIREBASE_STORAGE_UPLOAD=1
# 버킷 CORS 설정(프로젝트 루트 firebase-storage-cors.json):
#   gsutil cors set firebase-storage-cors.json gs://<버킷명>
#   예: gs://ping-3a510.firebasestorage.app  (Firebase 콘솔 · Storage에 표시된 버킷)

# --- 민감 데이터 자동 파기 (G) — Vercel Cron /api/cron/purge-sensitive-data ---
# CRON_SECRET=   # Vercel Cron Authorization Bearer
# PING_RECIPIENT_PURGE_HOURS=24
# PING_PURGE_DAYS_AFTER_DEPARTURE=30

# --- 관리자 (/admin) — UI PIN 과 API 키 분리 (서버 전용, 클라이언트·git 금지) ---
# UI 로그인: /admin/auth (rotate 후 새 값만 사용)
#   예: openssl rand -hex 16
# PING_ADMIN_UI_PASSWORD=
# 입금확인·발송 트리거 API (curl/자동화) — UI PIN 과 다른 값
# PING_ADMIN_API_KEY=
# (선택) 세션 쿠키 서명 — 미설정 시 PING_ADMIN_API_KEY 사용
# PING_ADMIN_SESSION_SECRET=
# (호환) 예전 단일 비밀번호 — UI 로그인에만 폴백, API 키로는 쓰이지 않음
# PING_ADMIN_PASSWORD=

# --- Solapi 대량발송 (알림톡 우선, LMS 폴백) — ping-dispatch 모듈 ---
# 콘솔: https://solapi.com  · 카카오 채널·알림톡 템플릿 사전 등록 필요.
# 백업: 프로젝트 루트에서 `npm run pack:dispatch` → ping-dispatch-1.0.0.tgz
#
# PING_DISPATCH_USE_SOLAPI=1
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_FROM=          # 비우면 `npm run test:solapi` 가 계정 ACTIVE 발신번호를 API로 조회
# PING_SEND_FROM_LABEL= # (선택) 플로우·결제완료 화면 발신번호 표시 — 미설정 시 SOLAPI_FROM 포맷
# SOLAPI_TEST_TO=       # 수신 테스트 번호(미지정 시 발신번호로 자가 LMS 테스트)
# PING_DISPATCH_PRIMARY_CHANNEL=kakao_alimtalk   # 또는 sms
# SOLAPI_KAKAO_PF_ID=          # 카카오 채널 ID (구 pfId)
# SOLAPI_KAKAO_TEMPLATE_ID=  # 승인된 알림톡 템플릿 ID
# PING_DISPATCH_BATCH_SIZE=1000
# PING_DISPATCH_FALLBACK_SMS=1
#
# --- 회원 이메일 인증 (Resend) ---
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=
# PING_PUBLIC_ORIGIN=
# PING_SKIP_EMAIL_VERIFICATION=

# --- 카카오 로그인 · 카카오싱크 (developers.kakao.com) ---
# 앱 → 플랫폼 → Web 사이트 도메인: http://localhost:3002 , https://ping.funexcloud.com
# 앱 → 카카오 로그인 → 활성화 ON · 카카오싱크(동의항목) 설정
#
# [호출 허용 IP] 앱 → 앱 설정 → 보안 → 호출 허용 IP
#   REST API 키로 서버에서 토큰 교환 시, 등록된 IP 외에서는 API 호출 불가.
#   등록 형식: IPv4(203.0.113.10), CIDR(203.0.113.0/24), Subnet Mask(203.0.113.0/255.255.255.0)
#   로컬 개발: 공인 IP 또는 VPN/터널 egress IP를 콘솔에 등록. (아래 env는 운영 메모용)
# KAKAO_SERVER_EGRESS_IP=203.0.113.10
# KAKAO_SERVER_EGRESS_CIDR=203.0.113.0/24
#
# [카카오 로그인 Redirect URI] 카카오 로그인 → Redirect URI — 아래 3개 등록
#   http://localhost:3002/api/auth/kakao/callback
#   http://localhost:3000/api/auth/kakao/callback
#   https://ping.funexcloud.com/api/auth/kakao/callback
#
# [비즈니스 인증 Redirect URI] 비즈니스 인증 → Redirect URI — 아래 3개 등록
#   http://localhost:3002/api/auth/kakao/business/callback
#   http://localhost:3000/api/auth/kakao/business/callback
#   https://ping.funexcloud.com/api/auth/kakao/business/callback
#
# REST API 키 (필수). Client Secret 사용 시 콘솔에서 활성화 후 아래에 입력.
KAKAO_REST_API_KEY=
# KAKAO_CLIENT_SECRET=
#
# 로컬 npm run dev — OAuth 콜백은 Express(:3000) 기준. (Next :3002 프록시도 동일 Express로 연결)
# ⚠️ 포트 3000에 다른 dev 서버(Vite 등)가 떠 있으면 Express가 안 뜨고 카카오 로그인이 깨집니다.
#   netstat -ano | findstr :3000  로 확인 후 종료하거나 PING_EXPRESS_PORT=3001 로 변경하세요.
KAKAO_REDIRECT_URI=http://localhost:3000/api/auth/kakao/callback
KAKAO_BUSINESS_REDIRECT_URI=http://localhost:3000/api/auth/kakao/business/callback
#
# (선택) JS SDK 사용 시
# NEXT_PUBLIC_KAKAO_JAVASCRIPT_KEY=
#
# OAuth 콜백 후 회원 로그인 페이지로 돌아갈 공개 origin (미설정 시 PING_PUBLIC_ORIGIN)
# KAKAO_LOGIN_RETURN_ORIGIN=http://localhost:3002
#
# 카카오싱크 약관 태그 — 비즈니스 콘솔 «동의 항목 › 약관»에 등록한 고유 코드.
# 이용약관은 ping_service_terms 로 식별(여러 개는 콤마 구분). 미설정 시 코드 기본값 사용.
# KAKAO_SERVICE_TERMS_TAGS=ping_service_terms

# --- Vercel Production: Express 없이 회원·게스트 인증 (Next /api/auth) ---
# Firebase Console → 프로젝트 설정 → 서비스 계정 → 비공개 키 JSON (한 줄로 Vercel에 등록)
#   npm run push:vercel-member-auth-env -- --sa path/to/firebase-adminsdk.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# PING_MEMBER_GCS_BUCKET=ping-3a510-member-auth
# PING_OAUTH_STATE_SECRET=   # openssl rand -hex 32 (미설정 시 스크립트가 생성)
